Version: 1.0
ProjectId: 739b107c-d7a4-4c43-b2fc-e4a69502c999

RestoreWorkspace: Default
SaveWorkspace: Default
AlwaysSaveHistory: Default

EnableCodeIndexing: Yes
UseSpacesForTab: Yes
NumSpacesForTab: 2
Encoding: UTF-8

RnwWeave: knitr
LaTeX: pdfLaTeX

BuildType: Package
PackageUseDevtools: Yes
PackageInstallArgs: --no-multiarch --with-keep.source
PackageBuildArgs: --compact-vignettes=gs  --resave-data
PackageBuildBinaryArgs: --compact-vignettes=gs  --resave-data
PackageCheckArgs: --as-cran
PackageRoxygenize: rd,collate,namespace,vignette
